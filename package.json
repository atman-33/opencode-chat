{
  "name": "opencode-chat-unofficial-custom",
  "displayName": "opencode chat (custom)",
  "description": "A custom fork of the opencode chat extension for local and remote VS Code workspaces",
  "repository": "https://github.com/atman-33/opencode-chat",
  "author": "atman-33",
  "publisher": "atman-dev",
  "version": "0.1.1",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "activationEvents": [],
  "extensionKind": [
    "workspace"
  ],
  "main": "./out/main.js",
  "contributes": {
    "commands": [
      {
        "command": "opencode.addToChat",
        "title": "opencode: Add to Chat",
        "icon": "$(add)"
      },
      {
        "command": "opencode.toggleChatView",
        "title": "opencode: Toggle Chat View"
      },
      {
        "command": "opencode.restart",
        "title": "opencode: Restart"
      },
      {
        "command": "opencode.addSelectionToChat",
        "title": "opencode: Add Selection to Chat",
        "icon": "$(add)"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "opencode.addToChat",
          "group": "navigation"
        }
      ],
      "editor/title/context": [
        {
          "command": "opencode.addToChat",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "opencode.addSelectionToChat",
          "when": "editorHasSelection",
          "group": "navigation"
        }
      ]
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "opencode-sidebar",
          "title": "opencode",
          "icon": "icon.svg"
        }
      ]
    },
    "views": {
      "opencode-sidebar": [
        {
          "type": "webview",
          "id": "opencode.chatView",
          "name": "Chat"
        }
      ]
    },
    "configuration": {
      "title": "opencode",
      "properties": {
        "opencode.port": {
          "type": "number",
          "default": 0,
          "minimum": 0,
          "maximum": 65535,
          "description": "Fixed port for the opencode server. Set to 0 (default) to use a random port. Note: changing the port resets preferences stored in the webview (e.g. theme) since they are tied to the origin."
        },
        "opencode.path": {
          "type": "string",
          "default": "",
          "description": "Full path to the opencode CLI executable. Leave empty to run opencode from PATH."
        },
        "opencode.exposeToNetwork": {
          "type": "boolean",
          "default": false,
          "description": "Expose the opencode server to the local network via mDNS. When enabled, you can access the same instance from another device at http://opencode.local:<port>."
        }
      }
    }
  },
  "scripts": {
    "copy-templates": "shx mkdir -p out/webview/templates && shx cp src/webview/templates/*.html out/webview/templates/",
    "compile": "tsc -p ./ && npm run copy-templates",
    "build": "npm run compile",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "publish": "npm run compile && vsce publish && ovsx publish",
    "watch": "npm run copy-templates && tsc -w -p ./"
  },
  "devDependencies": {
    "@types/cross-spawn": "^6.0.6",
    "@types/node": "^18.0.0",
    "@types/vscode": "^1.80.0",
    "shx": "^0.4.0",
    "typescript": "^5.0.0"
  },
  "dependencies": {
    "cross-spawn": "^7.0.3",
    "tree-kill": "^1.2.2"
  },
  "license": "MIT"
}
